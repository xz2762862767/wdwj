<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="colorPrimary">@color/accent_dark</item>
        <item name="colorPrimaryDark">@color/accent_dark</item>
        <item name="colorAccent">@color/accent</item>
        <item name="accent">@color/accent</item>
        <item name="accentDim">@color/accent_dim</item>
        <item name="accentSoft">@color/accent_soft</item>
        <item name="accentDark">@color/accent_dark</item>
        <item name="onAccent">@color/on_accent</item>
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:statusBarColor">?attr/accentDark</item>
    </style>

    <style name="ImageViewerTheme" parent="AppTheme">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:statusBarColor">@android:color/black</item>
        <item name="android:navigationBarColor">@android:color/black</item>
    </style>

    <style name="ViewerAction">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">36dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:background">@drawable/list_selector</item>
        <item name="android:gravity">center</item>
        <item name="android:singleLine">true</item>
        <item name="android:textColor">#FFFFFFFF</item>
        <item name="android:textSize">13sp</item>
    </style>

    <style name="ToolbarTitle">
        <item name="android:textColor">@color/on_accent</item>
        <item name="android:textSize">16sp</item>
        <item name="android:singleLine">true</item>
        <item name="android:ellipsize">middle</item>
    </style>

    <style name="PathBar">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">34dp</item>
        <item name="android:background">@drawable/bg_path_pill</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingLeft">10dp</item>
        <item name="android:paddingRight">10dp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">12sp</item>
        <item name="android:singleLine">true</item>
        <item name="android:ellipsize">middle</item>
        <item name="android:drawablePadding">6dp</item>
    </style>

    <style name="ToolbarButton">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:background">@drawable/list_selector</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingLeft">10dp</item>
        <item name="android:paddingRight">10dp</item>
        <item name="android:textColor">@color/on_accent</item>
        <item name="android:textSize">12sp</item>
        <item name="android:singleLine">true</item>
    </style>

    <style name="DrawerHeader">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:paddingLeft">20dp</item>
        <item name="android:paddingRight">20dp</item>
        <item name="android:paddingTop">24dp</item>
        <item name="android:paddingBottom">10dp</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">12sp</item>
        <item name="android:letterSpacing">0.03</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="DetailBarButton" parent="ToolbarButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_marginLeft">3dp</item>
        <item name="android:layout_marginRight">3dp</item>
        <item name="android:gravity">center</item>
        <item name="android:textSize">12sp</item>
        <item name="android:background">@drawable/bg_btn</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="DetailBarButtonPrimary" parent="DetailBarButton">
        <item name="android:background">@drawable/bg_btn_primary</item>
        <item name="android:textColor">#FFFFFFFF</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- ===== 主题颜色方案（设置 → 主题颜色） ===== -->
    <style name="Theme_MyFiles_Green" parent="AppTheme">
        <item name="colorPrimary">@color/accent_green_dark</item>
        <item name="colorPrimaryDark">@color/accent_green_dark</item>
        <item name="accentDark">@color/accent_green_dark</item>
        <item name="colorAccent">@color/accent_green</item>
        <item name="accent">@color/accent_green</item>
        <item name="accentDim">@color/accent_green_dim</item>
        <item name="accentSoft">@color/accent_green_soft</item>
    </style>

    <style name="Theme_MyFiles_Purple" parent="AppTheme">
        <item name="colorPrimary">@color/accent_purple_dark</item>
        <item name="colorPrimaryDark">@color/accent_purple_dark</item>
        <item name="accentDark">@color/accent_purple_dark</item>
        <item name="colorAccent">@color/accent_purple</item>
        <item name="accent">@color/accent_purple</item>
        <item name="accentDim">@color/accent_purple_dim</item>
        <item name="accentSoft">@color/accent_purple_soft</item>
    </style>

    <style name="Theme_MyFiles_Orange" parent="AppTheme">
        <item name="colorPrimary">@color/accent_orange_dark</item>
        <item name="colorPrimaryDark">@color/accent_orange_dark</item>
        <item name="accentDark">@color/accent_orange_dark</item>
        <item name="colorAccent">@color/accent_orange</item>
        <item name="accent">@color/accent_orange</item>
        <item name="accentDim">@color/accent_orange_dim</item>
        <item name="accentSoft">@color/accent_orange_soft</item>
    </style>

    <style name="Theme_MyFiles_Red" parent="AppTheme">
        <item name="colorPrimary">@color/accent_red_dark</item>
        <item name="colorPrimaryDark">@color/accent_red_dark</item>
        <item name="accentDark">@color/accent_red_dark</item>
        <item name="colorAccent">@color/accent_red</item>
        <item name="accent">@color/accent_red</item>
        <item name="accentDim">@color/accent_red_dim</item>
        <item name="accentSoft">@color/accent_red_soft</item>
    </style>

    <style name="Theme_MyFiles_Teal" parent="AppTheme">
        <item name="colorPrimary">@color/accent_teal_dark</item>
        <item name="colorPrimaryDark">@color/accent_teal_dark</item>
        <item name="accentDark">@color/accent_teal_dark</item>
        <item name="colorAccent">@color/accent_teal</item>
        <item name="accent">@color/accent_teal</item>
        <item name="accentDim">@color/accent_teal_dim</item>
        <item name="accentSoft">@color/accent_teal_soft</item>
    </style>

    <style name="Theme_MyFiles_Blue" parent="AppTheme">
        <item name="colorPrimary">@color/accent_blue_dark</item>
        <item name="colorPrimaryDark">@color/accent_blue_dark</item>
        <item name="accentDark">@color/accent_blue_dark</item>
        <item name="colorAccent">@color/accent_blue</item>
        <item name="accent">@color/accent_blue</item>
        <item name="accentDim">@color/accent_blue_dim</item>
        <item name="accentSoft">@color/accent_blue_soft</item>
    </style>

    <!-- 文件面板底部工具按钮（MT 风格，等分铺满） -->
    <style name="PaneToolButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:background">@drawable/list_selector</item>
        <item name="android:padding">10dp</item>
        <item name="android:scaleType">center</item>
    </style>
    <!-- MT 风格弹窗（用于应用/APK 信息）：浮窗 + 变暗背景；具体配色由运行时主题决定 -->
    <style name="Theme_MyFiles_Dialog">
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:windowMinWidthMajor">92%</item>
        <item name="android:windowMinWidthMinor">92%</item>
        <item name="android:windowCloseOnTouchOutside">true</item>
    </style>

    <!-- 关于弹窗（v5.9.39）里的「标签 —— 值」行 -->
    <style name="AboutRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:paddingTop">9dp</item>
        <item name="android:paddingBottom">9dp</item>
    </style>
    <style name="AboutRowLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">12.5sp</item>
    </style>
    <style name="AboutRowValue">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:gravity">end</item>
        <item name="android:singleLine">true</item>
        <item name="android:ellipsize">middle</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">12.5sp</item>
    </style>
</resources>
