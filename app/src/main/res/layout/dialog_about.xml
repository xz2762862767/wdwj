<?xml version="1.0" encoding="utf-8"?>
<!--
  关于弹窗（v5.9.39）：图标 → 应用名 → 副标题 → 信息卡 → 免责 → 版权。
  版式对齐用户给的参考图。
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="2dp"
        android:paddingEnd="20dp"
        android:paddingBottom="2dp">

        <ImageView
            android:id="@+id/about_icon"
            android:layout_width="62dp"
            android:layout_height="62dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="8dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_launcher" />

        <TextView
            android:id="@+id/about_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:text="@string/app_name"
            android:textColor="@color/text_primary"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/about_tagline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:gravity="center"
            android:text="@string/about_tagline"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/about_card_bg"
            android:orientation="vertical"
            android:paddingTop="3dp"
            android:paddingBottom="3dp">

            <LinearLayout
                style="@style/AboutRow">

                <TextView
                    style="@style/AboutRowLabel"
                    android:text="@string/about_row_version" />

                <TextView
                    android:id="@+id/about_version_value"
                    style="@style/AboutRowValue" />
            </LinearLayout>

            <LinearLayout
                style="@style/AboutRow">

                <TextView
                    style="@style/AboutRowLabel"
                    android:text="@string/about_row_package" />

                <TextView
                    android:id="@+id/about_package_value"
                    style="@style/AboutRowValue" />
            </LinearLayout>

            <LinearLayout
                style="@style/AboutRow">

                <TextView
                    style="@style/AboutRowLabel"
                    android:text="@string/about_row_engine" />

                <TextView
                    style="@style/AboutRowValue"
                    android:text="@string/about_value_engine" />
            </LinearLayout>

            <LinearLayout
                style="@style/AboutRow">

                <TextView
                    style="@style/AboutRowLabel"
                    android:text="@string/about_row_harden" />

                <TextView
                    style="@style/AboutRowValue"
                    android:text="@string/about_value_harden" />
            </LinearLayout>

            <LinearLayout
                style="@style/AboutRow">

                <TextView
                    style="@style/AboutRowLabel"
                    android:text="@string/about_row_storage" />

                <TextView
                    style="@style/AboutRowValue"
                    android:text="@string/about_value_storage" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginStart="14dp"
                android:layout_marginEnd="14dp"
                android:background="@color/divider" />

            <LinearLayout
                android:id="@+id/about_row_author_qq"
                style="@style/AboutRow"
                android:background="?attr/selectableItemBackground">

                <TextView
                    style="@style/AboutRowLabel"
                    android:text="@string/about_row_author_qq" />

                <TextView
                    android:id="@+id/about_author_qq_value"
                    style="@style/AboutRowValue"
                    android:text="@string/about_value_author_qq" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/about_row_group"
                style="@style/AboutRow"
                android:background="?attr/selectableItemBackground">

                <TextView
                    style="@style/AboutRowLabel"
                    android:text="@string/about_row_group" />

                <TextView
                    android:id="@+id/about_group_value"
                    style="@style/AboutRowValue"
                    android:text="@string/about_value_group" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/about_disclaimer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center"
            android:lineSpacingExtra="2dp"
            android:text="@string/about_disclaimer"
            android:textColor="@color/text_secondary"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/about_copyright"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="2dp"
            android:gravity="center"
            android:lineSpacingExtra="2dp"
            android:text="@string/about_copyright"
            android:textColor="@color/text_secondary"
            android:textSize="10sp" />
    </LinearLayout>
</ScrollView>
