<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical">

    <!-- 顶栏：主题色底 + 白色前景 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:background="?attr/accentDark"
        android:elevation="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/arc_back"
            android:layout_width="44dp"
            android:layout_height="match_parent"
            android:background="@drawable/list_selector"
            android:contentDescription="@string/act_back"
            android:padding="12dp"
            android:src="@drawable/ic_up"
            android:tint="@color/on_accent" />

        <TextView
            android:id="@+id/arc_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:paddingLeft="6dp"
            android:singleLine="true"
            android:text="@string/archive_title"
            android:textColor="@color/on_accent"
            android:textSize="17sp" />

        <TextView
            android:id="@+id/arc_action"
            style="@style/ToolbarButton"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:text="@string/archive_extract_all" />

        <ImageView
            android:id="@+id/arc_more"
            android:layout_width="44dp"
            android:layout_height="match_parent"
            android:background="@drawable/list_selector"
            android:contentDescription="@string/more"
            android:padding="12dp"
            android:src="@drawable/ic_more"
            android:tint="@color/on_accent" />
    </LinearLayout>

    <!-- 路径栏下方的信息行（条目数 / 总大小），与文件面板同风格 -->
    <TextView
        android:id="@+id/arc_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:paddingLeft="12dp"
        android:paddingTop="5dp"
        android:paddingRight="12dp"
        android:paddingBottom="5dp"
        android:singleLine="true"
        android:textColor="@color/text_secondary"
        android:textSize="10sp" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ListView
            android:id="@+id/arc_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:divider="@color/divider"
            android:dividerHeight="1dp"
            android:listSelector="@drawable/list_selector"
            android:scrollbars="vertical" />

        <TextView
            android:id="@+id/arc_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:text="@string/archive_empty"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>
