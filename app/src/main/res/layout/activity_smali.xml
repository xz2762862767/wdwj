<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:background="?attr/accentDark"
        android:elevation="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/smali_back"
            android:layout_width="44dp"
            android:layout_height="match_parent"
            android:background="@drawable/list_selector"
            android:contentDescription="@string/act_back"
            android:padding="12dp"
            android:src="@drawable/ic_up"
            android:tint="@color/on_accent" />

        <TextView
            android:id="@+id/smali_title"
            style="@style/ToolbarTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="middle"
            android:paddingLeft="6dp"
            android:singleLine="true"
            android:text="@string/dex_smali_title" />

        <TextView
            android:id="@+id/smali_edit"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:background="@drawable/list_selector"
            android:gravity="center"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:singleLine="true"
            android:text="@string/smali_edit"
            android:textColor="@color/on_accent"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/smali_lang"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:background="@drawable/list_selector"
            android:gravity="center"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:singleLine="true"
            android:text="@string/java_switch_to_java"
            android:textColor="@color/on_accent"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/smali_copy"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:background="@drawable/list_selector"
            android:gravity="center"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:singleLine="true"
            android:text="@string/act_copy"
            android:textColor="@color/on_accent"
            android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/smali_search_row"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <EditText
            android:id="@+id/smali_search"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@color/bg"
            android:hint="@string/dex_find_hint"
            android:importantForAutofill="no"
            android:inputType="text"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:singleLine="true"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_secondary"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/smali_next"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:background="@drawable/list_selector"
            android:gravity="center"
            android:paddingLeft="10dp"
            android:paddingRight="10dp"
            android:singleLine="true"
            android:text="@string/dex_find_next"
            android:textColor="@color/accent"
            android:textSize="12sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/smali_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:paddingLeft="12dp"
        android:paddingTop="4dp"
        android:paddingRight="12dp"
        android:paddingBottom="4dp"
        android:singleLine="true"
        android:textColor="@color/text_secondary"
        android:textSize="10sp" />

    <com.mtstyle.fm.PinchScrollView
        android:id="@+id/smali_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/bg"
        android:scrollbars="vertical">

        <com.mtstyle.fm.PinchHorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none">

            <TextView
                android:id="@+id/smali_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="8dp"
                android:textColor="@color/text_primary"
                android:textIsSelectable="true"
                android:textSize="11sp"
                android:typeface="monospace" />
        </com.mtstyle.fm.PinchHorizontalScrollView>
    </com.mtstyle.fm.PinchScrollView>

    <EditText
        android:id="@+id/smali_editor"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/bg"
        android:gravity="top|start"
        android:importantForAutofill="no"
        android:imeOptions="flagNoExtractUi"
        android:inputType="textMultiLine|textNoSuggestions"
        android:padding="8dp"
        android:scrollbars="vertical"
        android:textColor="@color/text_primary"
        android:textSize="11sp"
        android:typeface="monospace"
        android:visibility="gone" />
</LinearLayout>
