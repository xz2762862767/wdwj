<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:background="?attr/accentDark"
        android:elevation="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/dex_back"
            android:layout_width="44dp"
            android:layout_height="match_parent"
            android:background="@drawable/list_selector"
            android:contentDescription="@string/act_back"
            android:padding="12dp"
            android:src="@drawable/ic_up"
            android:tint="@color/on_accent" />

        <TextView
            android:id="@+id/dex_title"
            style="@style/ToolbarTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="middle"
            android:paddingLeft="6dp"
            android:singleLine="true"
            android:text="@string/dex_title" />

        <TextView
            android:id="@+id/dex_dexpick"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:background="@drawable/list_selector"
            android:gravity="center"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:singleLine="true"
            android:text="@string/dex_switch"
            android:textColor="@color/on_accent"
            android:textSize="12sp" />
    </LinearLayout>

    <EditText
        android:id="@+id/dex_search"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:background="@color/bg"
        android:hint="@string/dex_search_hint"
        android:importantForAutofill="no"
        android:inputType="text"
        android:paddingLeft="12dp"
        android:paddingRight="12dp"
        android:singleLine="true"
        android:textColor="@color/text_primary"
        android:textColorHint="@color/text_secondary"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/dex_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:paddingLeft="12dp"
        android:paddingTop="4dp"
        android:paddingRight="12dp"
        android:paddingBottom="4dp"
        android:singleLine="true"
        android:textColor="@color/text_secondary"
        android:textSize="10sp" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ListView
            android:id="@+id/dex_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:divider="@color/divider"
            android:dividerHeight="1dp"
            android:listSelector="@drawable/list_selector"
            android:scrollbars="vertical" />

        <TextView
            android:id="@+id/dex_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:text="@string/dex_empty"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>
