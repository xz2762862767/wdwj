<?xml version="1.0" encoding="utf-8"?>
<!-- v5.7：免Root脱壳界面（选目标 → 进度 → 结果，三个阶段共用一个 FrameLayout） -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical">

    <!-- 顶部栏 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:background="@color/toolbar"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/btn_back"
            android:layout_width="44dp"
            android:layout_height="match_parent"
            android:background="@drawable/list_selector"
            android:contentDescription="@string/act_back"
            android:padding="12dp"
            android:src="@drawable/ic_up" />

        <TextView
            android:id="@+id/dump_title"
            style="@style/ToolbarTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:paddingStart="6dp"
            android:text="@string/dump_title" />

        <TextView
            android:id="@+id/btn_search"
            style="@style/ToolbarButton"
            android:paddingEnd="14dp"
            android:text="@string/search" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:background="?attr/accent" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- ==================== 阶段一：选目标 ==================== -->
        <LinearLayout
            android:id="@+id/stage_pick"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <!-- 引擎卡片 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="10dp"
                android:layout_marginTop="10dp"
                android:layout_marginRight="10dp"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:id="@+id/engine_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/engine_sub"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/out_dir"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/engine_action"
                        style="@style/DetailBarButtonPrimary"
                        android:text="@string/dump_engine_open" />

                    <TextView
                        android:id="@+id/engine_refresh"
                        style="@style/DetailBarButton"
                        android:text="@string/dump_engine_refresh" />
                </LinearLayout>
            </LinearLayout>

            <!-- 目标来源切换 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="10dp"
                android:background="@color/toolbar"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/tab_apps"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/list_selector"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tab_apps_text"
                        android:layout_width="wrap_content"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="@string/dump_tab_apps"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp" />

                    <View
                        android:id="@+id/tab_apps_line"
                        android:layout_width="52dp"
                        android:layout_height="2dp"
                        android:background="?attr/accent" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/tab_apk"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/list_selector"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tab_apk_text"
                        android:layout_width="wrap_content"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="@string/dump_tab_apk"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp" />

                    <View
                        android:id="@+id/tab_apk_line"
                        android:layout_width="52dp"
                        android:layout_height="2dp"
                        android:background="?attr/accent"
                        android:visibility="invisible" />
                </LinearLayout>

                <TextView
                    android:id="@+id/btn_browse"
                    style="@style/ToolbarButton"
                    android:layout_height="match_parent"
                    android:paddingEnd="14dp"
                    android:text="@string/dump_browse"
                    android:textColor="@color/text_primary"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- v5.9.37 来源筛选：全部 / 本机应用 / 系统应用（APK 模式自动隐藏） -->
            <LinearLayout
                android:id="@+id/filter_bar"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:background="@color/toolbar"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingEnd="12dp">

                <TextView
                    android:id="@+id/filter_user"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:minHeight="26dp"
                    android:gravity="center"
                    android:paddingStart="13dp"
                    android:paddingEnd="13dp"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/filter_system"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:minHeight="26dp"
                    android:gravity="center"
                    android:paddingStart="13dp"
                    android:paddingEnd="13dp"
                    android:textSize="12sp" />
            </LinearLayout>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

                <ListView
                    android:id="@+id/target_list"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:divider="@color/divider"
                    android:dividerHeight="1dp"
                    android:listSelector="@drawable/list_selector"
                    android:scrollbars="vertical" />

                <TextView
                    android:id="@+id/target_empty"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:paddingLeft="28dp"
                    android:paddingRight="28dp"
                    android:text="@string/list_empty"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp"
                    android:visibility="gone" />
            </FrameLayout>

            <!-- 底部：选择提示 + 开始 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:background="@color/toolbar"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/pick_hint"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="middle"
                    android:paddingStart="14dp"
                    android:singleLine="true"
                    android:text="@string/dump_pick_hint"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/btn_quick"
                    style="@style/ToolbarButton"
                    android:layout_height="match_parent"
                    android:paddingEnd="8dp"
                    android:text="@string/dump_quick_unpack"
                    android:textColor="@color/text_primary"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/btn_start"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_marginEnd="10dp"
                    android:background="@drawable/bg_btn_primary"
                    android:gravity="center"
                    android:paddingStart="18dp"
                    android:paddingEnd="18dp"
                    android:text="@string/dump_start"
                    android:textColor="#FFFFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- ==================== 阶段二：脱壳中 ==================== -->
        <LinearLayout
            android:id="@+id/stage_run"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="16dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/run_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/dump_run_title"
                android:textColor="@color/text_primary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/run_target"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:singleLine="true"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <ProgressBar
                android:id="@+id/run_bar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:indeterminate="true" />

            <TextView
                android:id="@+id/run_phase"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/dump_phase_prepare"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/run_dex"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="12dp"
                android:layout_weight="1"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="10dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/dump_log_title"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <ScrollView
                    android:id="@+id/log_scroll"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:layout_marginTop="6dp">

                    <TextView
                        android:id="@+id/run_log"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="monospace"
                        android:textColor="@color/text_secondary"
                        android:textSize="11sp" />
                </ScrollView>
            </LinearLayout>

            <TextView
                android:id="@+id/run_hint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/dump_run_hint"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/btn_tip"
                style="@style/DetailBarButton"
                android:layout_height="40dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_btn"
                android:text="@string/dump_tip_slow" />

            <TextView
                android:id="@+id/btn_background"
                style="@style/DetailBarButton"
                android:layout_height="44dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_btn"
                android:text="@string/dump_run_background" />
        </LinearLayout>

        <!-- ==================== 阶段三：结果 ==================== -->
        <LinearLayout
            android:id="@+id/stage_done"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="16dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/done_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_primary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/done_msg"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:lineSpacingExtra="3dp"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/done_dir"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:fontFamily="monospace"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="12dp"
                android:layout_weight="1"
                android:background="@drawable/bg_card">

                <TextView
                    android:id="@+id/done_files"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:lineSpacingExtra="4dp"
                    android:padding="12dp"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />
            </ScrollView>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btn_open_dir"
                    style="@style/DetailBarButtonPrimary"
                    android:text="@string/dump_open_dir" />

                <TextView
                    android:id="@+id/btn_again"
                    style="@style/DetailBarButton"
                    android:text="@string/dump_again" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginTop="3dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btn_view_log"
                    style="@style/DetailBarButton"
                    android:text="@string/dump_view_log" />

                <TextView
                    android:id="@+id/btn_copy_path"
                    style="@style/DetailBarButton"
                    android:text="@string/dump_copy_path" />

                <TextView
                    android:id="@+id/btn_close"
                    style="@style/DetailBarButton"
                    android:text="@string/dump_close" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
