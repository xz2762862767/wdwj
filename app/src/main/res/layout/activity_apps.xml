<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical">

    <!-- 顶部栏 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:background="@color/toolbar"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/btn_back"
            android:layout_width="44dp"
            android:layout_height="match_parent"
            android:background="@drawable/list_selector"
            android:contentDescription="@string/act_back"
            android:padding="12dp"
            android:src="@drawable/ic_up" />

        <TextView
            android:id="@+id/apps_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:singleLine="true"
            android:textColor="@color/text_primary"
            android:textSize="17sp" />

        <TextView
            android:id="@+id/btn_search"
            style="@style/ToolbarButton"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:paddingEnd="14dp"
            android:text="@string/search" />
    </LinearLayout>

    <!-- 主题色指示线 -->
    <View
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:background="?attr/accent" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ListView
            android:id="@+id/apps_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@android:color/transparent"
            android:divider="@color/divider"
            android:dividerHeight="1dp"
            android:listSelector="@drawable/list_selector"
            android:scrollbars="vertical" />

        <TextView
            android:id="@+id/apps_empty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="@string/list_empty"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:visibility="gone" />
    </FrameLayout>

    <!-- 底部：用户应用 / 系统应用 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@color/toolbar"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/tab_user"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/list_selector"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tab_user_text"
                android:layout_width="wrap_content"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="@string/apps_tab_user"
                android:textColor="@color/text_primary"
                android:textSize="13sp" />

            <View
                android:id="@+id/tab_user_line"
                android:layout_width="52dp"
                android:layout_height="2dp"
                android:background="?attr/accent" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tab_system"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/list_selector"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tab_system_text"
                android:layout_width="wrap_content"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="@string/apps_tab_system"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />

            <View
                android:id="@+id/tab_system_line"
                android:layout_width="52dp"
                android:layout_height="2dp"
                android:background="?attr/accent"
                android:visibility="invisible" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
