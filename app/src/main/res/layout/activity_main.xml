<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- ============ 主内容：顶部栏 + 双列面板 + 底部状态栏 ============ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/bg"
        android:orientation="vertical">

        <FrameLayout
            android:id="@+id/topbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_toolbar">

            <!-- 普通工具栏 -->
            <LinearLayout
                android:id="@+id/normal_bar"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/btn_menu"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_icon_chip_bar"
                android:tint="@color/on_accent"
                    android:contentDescription="@string/drawer_open"
                    android:scaleType="center"
                    android:src="@drawable/ic_menu" />

                <TextView
                    android:id="@+id/top_title"
                    style="@style/ToolbarTitle"
                    android:textStyle="bold"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:paddingStart="6dp"
                    android:paddingEnd="6dp"
                    android:text="@string/app_name" />

                <ImageButton
                    android:id="@+id/btn_up"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:layout_marginEnd="2dp"
                    android:background="@drawable/bg_icon_chip_bar"
                android:tint="@color/on_accent"
                    android:contentDescription="@string/up"
                    android:scaleType="center"
                    android:src="@drawable/ic_up" />

                <ImageButton
                    android:id="@+id/btn_more"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_icon_chip_bar"
                android:tint="@color/on_accent"
                    android:contentDescription="@string/more"
                    android:scaleType="center"
                    android:src="@drawable/ic_more" />
            </LinearLayout>

            <!-- 多选工具栏 -->
            <LinearLayout
                android:id="@+id/select_bar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:background="@drawable/bg_select_bar"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/select_count"
                        style="@style/ToolbarTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:paddingStart="12dp"
                        android:paddingEnd="4dp"
                        android:text="@string/app_name" />

                    <TextView
                        android:id="@+id/btn_sel_all"
                        style="@style/ToolbarButton"
                        android:text="@string/select_all" />

                    <TextView
                        android:id="@+id/btn_sel_invert"
                        style="@style/ToolbarButton"
                        android:text="@string/select_invert" />

                    <TextView
                        android:id="@+id/btn_sel_done"
                        style="@style/ToolbarButton"
                        android:paddingEnd="12dp"
                        android:text="@string/select_done"
                        android:textColor="@color/on_accent"
                        android:textStyle="bold" />
                </LinearLayout>

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:background="@android:color/transparent"
                    android:scrollbars="none">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/act_copy"
                            style="@style/ToolbarButton"
                            android:text="@string/act_copy" />

                        <TextView
                            android:id="@+id/act_cut"
                            style="@style/ToolbarButton"
                            android:text="@string/act_cut" />

                        <TextView
                            android:id="@+id/act_paste"
                            style="@style/ToolbarButton"
                            android:text="@string/act_paste" />

                        <TextView
                            android:id="@+id/act_copy_other"
                            style="@style/ToolbarButton"
                            android:text="@string/act_copy_other" />

                        <TextView
                            android:id="@+id/act_move_other"
                            style="@style/ToolbarButton"
                            android:text="@string/act_move_other" />

                        <TextView
                            android:id="@+id/act_delete"
                            style="@style/ToolbarButton"
                            android:text="@string/act_delete" />

                        <TextView
                            android:id="@+id/act_zip"
                            style="@style/ToolbarButton"
                            android:text="@string/act_zip" />

                        <TextView
                            android:id="@+id/act_unzip"
                            style="@style/ToolbarButton"
                            android:text="@string/act_unzip" />

                        <TextView
                            android:id="@+id/act_share"
                            style="@style/ToolbarButton"
                            android:text="@string/act_share" />

                        <TextView
                            android:id="@+id/act_rename"
                            style="@style/ToolbarButton"
                            android:text="@string/act_rename" />

                        <TextView
                            android:id="@+id/act_info"
                            style="@style/ToolbarButton"
                            android:text="@string/act_info" />
                    </LinearLayout>
                </HorizontalScrollView>
            </LinearLayout>
            <View
                android:layout_width="match_parent"
                android:layout_height="2dp"
                android:layout_gravity="bottom"
                android:background="?attr/accent" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <include
                android:id="@+id/pane_left"
                layout="@layout/pane_file"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1" />

            <View
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:background="@android:color/transparent" />

            <include
                android:id="@+id/pane_right"
                layout="@layout/pane_file"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1" />
        </LinearLayout>

    </LinearLayout>

    <!-- ============ 左侧侧滑栏 ============ -->
    <LinearLayout
        android:layout_width="322dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="@color/drawer_bg"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_toolbar"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingLeft="18dp"
            android:paddingTop="18dp"
            android:paddingRight="8dp"
            android:paddingBottom="18dp">

            <!-- v4.9：抽屉头部品牌图标 -->
            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginEnd="12dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_launcher" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/app_name"
                    android:textColor="@color/on_accent"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/drawer_subtitle"
                    android:textColor="@color/on_accent_secondary"
                    android:textSize="11sp" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/btn_add_bookmark"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@drawable/bg_icon_chip_bar"
                android:tint="@color/on_accent"
                android:contentDescription="@string/add_bookmark"
                android:scaleType="center"
                android:src="@drawable/ic_add" />
        </LinearLayout>

        <ListView
            android:id="@+id/drawer_list"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:paddingTop="10dp"
            android:paddingBottom="16dp"
            android:clipToPadding="false"
            android:divider="@null"
            android:dividerHeight="0dp"
            android:listSelector="@android:color/transparent"
            android:scrollbars="none" />

        <!-- 底部固定「更多」入口（始终贴在侧滑栏最下面） -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/toolbar_line" />

        <LinearLayout
            android:id="@+id/drawer_more"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/drawer_item_bg"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:minHeight="62dp"
            android:orientation="horizontal"
            android:paddingLeft="20dp"
            android:paddingTop="14dp"
            android:paddingRight="16dp"
            android:paddingBottom="14dp">

            <ImageView
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@drawable/bg_drawer_chip"
                android:contentDescription="@null"
                android:padding="9dp"
                android:src="@drawable/ic_more"
                android:tint="?attr/accent" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="13dp"
                android:layout_weight="1"
                android:text="@string/more"
                android:textColor="@color/text_primary"
                android:textSize="15sp" />
        </LinearLayout>
    </LinearLayout>

</androidx.drawerlayout.widget.DrawerLayout>
